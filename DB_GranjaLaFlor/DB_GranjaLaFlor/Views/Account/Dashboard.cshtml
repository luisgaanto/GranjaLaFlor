@using System.Security.Claims

@{
    ViewData["Title"] = "Dashboard";

    var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol asignado";
}

<div class="dashboard-page">

    <div class="container-fluid dashboard-container">

        <div class="card dashboard-hero mb-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <div class="col-md-3 text-center mb-3 mb-md-0">

                        <img src="~/imagenes/LogoGranjaLaFlor.png"
                             alt="Logo Granja La Flor"
                             class="img-fluid dashboard-logo" />

                    </div>

                    <div class="col-md-9">

                        <h2 class="dashboard-title mb-2">
                            Dashboard
                        </h2>

                        <h5 class="dashboard-subtitle text-muted mb-3">
                            Bienvenido, @User.Identity?.Name
                        </h5>

                        <div class="d-flex flex-wrap gap-2">

                            <span class="badge bg-primary dashboard-badge">
                                Usuario: @User.Identity?.Name
                            </span>

                            <span class="badge bg-info dashboard-badge">
                                Rol: @roleName
                            </span>

                        </div>

                        <p class="dashboard-system-name mt-3 mb-0">
                            Sistema de Gestión Operativa - Granja La Flor
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="card dashboard-production-card mb-4">

            <div class="dashboard-card-strip bg-primary"></div>

            <div class="card-body p-4">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

                    <div>

                        <h4 class="dashboard-production-title mb-1">
                            Estado Actual de Producción
                        </h4>

                        <p class="dashboard-production-subtitle mb-0">
                            Resumen operativo de las polleras activas.
                        </p>

                    </div>

                    <span class="badge bg-secondary dashboard-status-badge mt-3 mt-md-0">
                        Información en desarrollo
                    </span>

                </div>

                <div class="row g-4">

                    <div class="col-xl-6">

                        <div class="dashboard-broiler-house-card">

                            <div class="dashboard-broiler-house-layout">

                                <div class="dashboard-broiler-house-sidebar">

                                    <div class="dashboard-production-icon-container mb-3">

                                        <i class="bi bi-house-door-fill text-primary"></i>

                                    </div>

                                    <h5 class="dashboard-broiler-house-name">
                                        Pollera 1
                                    </h5>

                                    <span class="badge bg-info mb-3">
                                        Activa
                                    </span>

                                    <p class="dashboard-broiler-house-description mb-0">
                                        Información operativa actual de la pollera.
                                    </p>

                                </div>

                                <div class="dashboard-broiler-house-metrics">

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-primary bg-opacity-10">

                                            <i class="bi bi-egg-fill text-primary"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Saldo actual de aves
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-warning bg-opacity-10">

                                            <i class="bi bi-box-seam-fill text-warning"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Alimento actual
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-danger bg-opacity-10">

                                            <i class="bi bi-clipboard2-pulse-fill text-danger"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Mortalidad acumulada
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-secondary bg-opacity-10">

                                            <i class="bi bi-calendar-check-fill text-secondary"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Último control registrado
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-6">

                        <div class="dashboard-broiler-house-card">

                            <div class="dashboard-broiler-house-layout">

                                <div class="dashboard-broiler-house-sidebar">

                                    <div class="dashboard-production-icon-container mb-3">

                                        <i class="bi bi-house-door-fill text-success"></i>

                                    </div>

                                    <h5 class="dashboard-broiler-house-name">
                                        Pollera 2
                                    </h5>

                                    <span class="badge bg-info mb-3">
                                        Activa
                                    </span>

                                    <p class="dashboard-broiler-house-description mb-0">
                                        Información operativa actual de la pollera.
                                    </p>

                                </div>

                                <div class="dashboard-broiler-house-metrics">

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-primary bg-opacity-10">

                                            <i class="bi bi-egg-fill text-primary"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Saldo actual de aves
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-warning bg-opacity-10">

                                            <i class="bi bi-box-seam-fill text-warning"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Alimento actual
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-danger bg-opacity-10">

                                            <i class="bi bi-clipboard2-pulse-fill text-danger"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Mortalidad acumulada
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                    <div class="dashboard-metric-row">

                                        <div class="dashboard-metric-icon bg-secondary bg-opacity-10">

                                            <i class="bi bi-calendar-check-fill text-secondary"></i>

                                        </div>

                                        <div class="dashboard-metric-content">

                                            <span class="dashboard-metric-label">
                                                Último control registrado
                                            </span>

                                            <span class="dashboard-metric-value">
                                                Próximamente
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h4 class="dashboard-section-title mb-1">
                    Módulos del Sistema
                </h4>

                <p class="dashboard-section-subtitle mb-0">
                    Acceso rápido a las funciones de gestión operativa.
                </p>

            </div>

        </div>

        <div class="row">

            @if (User.IsInRole("Propietario"))
            {
                <div class="col-xl-4 col-md-6 mb-4">

                    <div class="card dashboard-module-card h-100">

                        <div class="dashboard-card-strip bg-primary"></div>

                        <div class="card-body dashboard-card-body">

                            <div class="dashboard-icon-container">

                                <i class="bi bi-people-fill dashboard-icon text-primary"></i>

                            </div>

                            <h5 class="dashboard-card-title">
                                Acceso y Usuarios
                            </h5>

                            <p class="dashboard-card-text">
                                Administración de roles, usuarios y permisos del sistema.
                            </p>

                            <div class="dashboard-card-action">

                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">

                                    Ver usuarios

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

            <div class="col-xl-4 col-md-6 mb-4">

                <div class="card dashboard-module-card h-100">

                    <div class="dashboard-card-strip bg-primary"></div>

                    <div class="card-body dashboard-card-body">

                        <div class="dashboard-icon-container">

                            <i class="bi bi-house-door-fill dashboard-icon text-primary"></i>

                        </div>

                        <h5 class="dashboard-card-title">
                            Polleras
                        </h5>

                        <p class="dashboard-card-text">
                            Consulta y administración de las polleras disponibles
                            para la gestión de camadas.
                        </p>

                        <div class="dashboard-card-action">

                            <a asp-controller="BroilerHouses"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Ver polleras

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-4 col-md-6 mb-4">

                <div class="card dashboard-module-card h-100">

                    <div class="dashboard-card-strip bg-primary"></div>

                    <div class="card-body dashboard-card-body">

                        <div class="dashboard-icon-container">

                            <i class="bi bi-diagram-3-fill dashboard-icon text-primary"></i>

                        </div>

                        <h5 class="dashboard-card-title">
                            Camadas
                        </h5>

                        <p class="dashboard-card-text">
                            Registro y seguimiento de camadas asociadas
                            a cada pollera activa.
                        </p>

                        <div class="dashboard-card-action">

                            <a asp-controller="Broods"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Ver camadas

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-4 col-md-6 mb-4">

                <div class="card dashboard-module-card h-100">

                    <div class="dashboard-card-strip bg-primary"></div>

                    <div class="card-body dashboard-card-body">

                        <div class="dashboard-icon-container">

                            <i class="bi bi-box-seam-fill dashboard-icon text-primary"></i>

                        </div>

                        <h5 class="dashboard-card-title">
                            Ingreso Alimento
                        </h5>

                        <p class="dashboard-card-text">
                            Control de ingreso de concentrado, kilos,
                            quintales y acumulados por camada.
                        </p>

                        <div class="dashboard-card-action">

                            <a asp-controller="IncomeConcentrates"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Ver ingresos

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-4 col-md-6 mb-4">

                <div class="card dashboard-module-card h-100">

                    <div class="dashboard-card-strip bg-primary"></div>

                    <div class="card-body dashboard-card-body">

                        <div class="dashboard-icon-container">

                            <i class="bi bi-clipboard2-pulse-fill dashboard-icon text-primary"></i>

                        </div>

                        <h5 class="dashboard-card-title">
                            Control Diario
                        </h5>

                        <p class="dashboard-card-text">
                            Registro diario de la operación avícola,
                            control de mortalidad y acumulados.
                        </p>

                        <div class="dashboard-card-action">

                            <a asp-controller="DailyChecks"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Ver Control Diario

                            </a>

                        </div>

                    </div>

                </div>

            </div>
            
            <div class="col-xl-4 col-md-6 mb-4">

                <div class="card dashboard-module-card h-100">

                    <div class="dashboard-card-strip bg-primary"></div>

                    <div class="card-body dashboard-card-body">

                        <div class="dashboard-icon-container">

                            <i class="bi bi-clipboard2-pulse-fill dashboard-icon text-primary"></i>

                        </div>

                        <h5 class="dashboard-card-title">
                            Control Semanal
                        </h5>

                        <p class="dashboard-card-text">
                            Registro semanal de la operación avícola, control real
                            y esperado de consumo, peso, conversion, Mortalidad.
                        </p>

                        <div class="dashboard-card-action">

                            <a asp-controller="WeeklyChecks"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Ver Control Semanal

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>