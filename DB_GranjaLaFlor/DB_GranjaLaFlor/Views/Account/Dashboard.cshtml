@using System.Security.Claims

@{
    ViewData["Title"] = "Dashboard";

    var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol asignado";
}

<div class="container mt-4">

    <div class="card border-primary mb-4 shadow-sm">
        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <img src="~/imagenes/LogoGranjaLaFlor.png"
                         alt="Logo Granja La Flor"
                         class="img-fluid"
                         style="max-width: 160px;" />
                </div>

                <div class="col-md-9">
                    <h2 class="mb-2">Dashboard</h2>

                    <h5 class="text-muted mb-3">
                        Bienvenido, @User.Identity?.Name
                    </h5>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary">
                            Usuario: @User.Identity?.Name
                        </span>

                        <span class="badge bg-info">
                            Rol: @roleName
                        </span>
                    </div>

                    <p class="mt-3 mb-0">
                        Sistema de Gestión Operativa - Granja La Flor
                    </p>
                </div>

            </div>

        </div>
    </div>

    <div class="row">

        @if (User.IsInRole("Propietario"))
        {
            <div class="col-md-4 mb-4">
                <div class="card border-success h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Acceso y Usuarios</h5>

                        <p class="card-text">
                            Administración de roles, usuarios y permisos del sistema.
                        </p>

                        <a asp-controller="Broods"
                           asp-action="Index"
                           class="btn btn-outline-success">
                            Camadas
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4 mb-4">
            <div class="card border-primary h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Polleras</h5>

                    <p class="card-text">
                        Consulta de las polleras disponibles para la gestión de camadas.
                    </p>

                    <a asp-controller="BroilerHouses"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Ver polleras
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-info h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Camadas</h5>

                    <p class="card-text">
                        Registro y seguimiento de camadas asociadas a cada pollera.
                    </p>

                    <button class="btn btn-outline-info" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-danger h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Mortalidad</h5>

                    <p class="card-text">
                        Registro y control de mortalidad natural y selección de aves.
                    </p>

                    <button class="btn btn-outline-danger" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-warning h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Alimento</h5>

                    <p class="card-text">
                        Control de consumo e ingreso de concentrado por camada.
                    </p>

                    <button class="btn btn-outline-warning" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card border-secondary h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Monitoreo</h5>

                    <p class="card-text">
                        Monitoreo de temperatura y estimulación temprana.
                    </p>

                    <button class="btn btn-outline-secondary" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

    </div>

</div>