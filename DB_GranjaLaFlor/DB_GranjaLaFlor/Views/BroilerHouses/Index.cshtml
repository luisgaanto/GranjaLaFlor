@model IEnumerable<DB_GranjaLaFlor.Models.Entities.BroilerHouse>

@{
    ViewData["Title"] = "Polleras";
}

<div class="container mt-4">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">
                Polleras
            </h2>
        </div>

        <div class="card-body">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>
                            @Html.DisplayNameFor(model => model.BroilerHouseName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.BroilerHouseDescription)
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.BroilerHouseName
                            </td>

                            <td>
                                @item.BroilerHouseDescription
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>