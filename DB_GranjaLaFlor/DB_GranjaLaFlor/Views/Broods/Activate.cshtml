@model DB_GranjaLaFlor.Models.ViewModels.Broods.BroodGetByIdViewModel

@{
    ViewData["Title"] = "Reactivar Camada";
}

<div class="container mt-4 col-md-7">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">
                Reactivar Camada
            </h1>
        </div>

        <div class="card-body">

            <!-- When using Partial view, you can use "Partial Tag Helper" to mapped event message as below. Refer to _EventMessage view.-->
            <partial name="_EventMessage" />

            <table class="table table-hover table-bordered align-middle">

                <tbody>

                    <tr class="table-active">
                        <th style="width:35%">
                            @Html.DisplayNameFor(model => model.BroodName)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroodName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodDate)
                        </th>
                        <td>
                            @Model.BroodDate.ToString("dd/MM/yyyy")
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodBirdInitialNum)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroodBirdInitialNum)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroilerHouseName)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroilerHouseName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodDescription)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroodDescription)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodState)
                        </th>
                        <td>
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>

            <form asp-action="ActivateConfirmed"
                  asp-route-id="@Model.BroodId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="BroodId" />

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Reactivar
                    </button>

                    <a asp-action="Inactive"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>