@model DB_GranjaLaFlor.Models.ViewModels.Broods.BroodGetByIdViewModel

@{
    ViewData["Title"] = "Detalle de Camada";
}

<div class="container mt-4 col-md-7">
    <div class="card border-info">
        <div class="card-header bg-info text-white text-center">
            <h1 class="mb-0">Detalle de Camada</h1>
        </div>

        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.BroodName</dd>

                <dt class="col-sm-4">Fecha de Ingreso</dt>
                <dd class="col-sm-8">@Model.BroodDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4">Aves Iniciales</dt>
                <dd class="col-sm-8">@Model.BroodBirdInitialNum</dd>

                <dt class="col-sm-4">Pollera</dt>
                <dd class="col-sm-8">@Model.BroilerHouseName</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.BroodDescription</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    @if (Model.BroodState)
                    {
                        <span class="badge bg-info">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>
            </dl>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Volver
            </a>

        </div>
    </div>
</div>