@model IEnumerable<DB_GranjaLaFlor.Models.ViewModels.Broods.BroodListViewModel>

@{
    ViewData["Title"] = "Camadas";
}

<div class="container mt-4">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">Listado de Camadas</h3>
        </div>

        <div class="card-body">


            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Camadas Activas Registradas</h5>

                <a asp-action="Create" class="btn btn-outline-primary">
                    Nueva Camada
                </a>
                <a asp-action="Inactive" class="btn btn-outline-secondary">
                    Ver Inactivas
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>Nombre</th>
                            <th>Fecha de Ingreso</th>
                            <th>Aves Iniciales</th>
                            <th>Pollera</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-center" style="width: 170px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var brood in Model)
                            {
                                <tr>
                                    <td>@brood.BroodName</td>
                                    <td>@brood.BroodDate.ToString("dd/MM/yyyy")</td>
                                    <td>@brood.BroodBirdInitialNum</td>
                                    <td>@brood.BroilerHouseName</td>
                                    <td>@brood.BroodDescription</td>
                                    <td>
                                        <span class="badge bg-info">
                                            Activo
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-info btn-sm">
                                                Detalle
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-warning btn-sm">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-danger btn-sm">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    No existen camadas registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>

</div>