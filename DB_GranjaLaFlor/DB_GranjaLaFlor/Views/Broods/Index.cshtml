@model IEnumerable<DB_GranjaLaFlor.Models.ViewModels.Broods.BroodListViewModel>

@{
    ViewData["Title"] = "Listado de Camadas";
}

<div class="container mt-4">

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">
                Listado de Camadas
            </h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    Camadas Activas Registradas
                </h5>

                <div class="d-flex gap-2">

                    <a asp-action="Create"
                       class="btn btn-outline-primary">
                        Nueva Camada
                    </a>

                    <a asp-action="Inactive"
                       class="btn btn-outline-secondary">
                        Ver Inactivas
                    </a>

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.BroodName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroodDate)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroodBirdInitialNum)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroilerHouseName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroodDescription)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroodState)
                            </th>

                            <th class="text-center" style="width: 170px;">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var brood in Model)
                            {
                                <tr class="table-active">
                                    <td>
                                        @brood.BroodName
                                    </td>

                                    <td>
                                        @brood.BroodDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @brood.BroodBirdInitialNum
                                    </td>

                                    <td>
                                        @brood.BroilerHouseName
                                    </td>

                                    <td>
                                        @brood.BroodDescription
                                    </td>

                                    <td>
                                        @if (brood.BroodState)
                                        {
                                            <span class="badge bg-info">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-info btn-sm">

                                                Detalle

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-warning btn-sm">

                                                Editar

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@brood.BroodId"
                                               class="btn btn-outline-danger btn-sm">

                                                Eliminar

                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted">

                                    No existen camadas registradas.

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section Scripts
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const alerts = document.querySelectorAll(".alert");

                alerts.forEach(function (alert) {

                    setTimeout(function () {

                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bsAlert.close();

                    }, 2500);

                });

            });
        </script>
    }
</div>