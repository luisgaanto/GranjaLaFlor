@model ProjectGranjaLaFlor.Models.ViewModels.DailyCheckGetByIdViewModel

@{
    ViewData["Title"] = "Detalle del Control Diario";
}

<div class="container mt-4 col-md-7">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">
                Detalle del Control Diario
            </h1>
        </div>

        <div class="card-body">

            <table class="table table-hover table-bordered align-middle">

                <tbody>

                    <tr class="table-active">
                        <th style="width:35%">
                            @Html.DisplayNameFor(model => model.DailyCheckState)
                        </th>
                        <td>
                            @if (Model.DailyCheckState)
                            {
                                <span class="badge bg-info">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.DailyCheckDate)
                        </th>
                        <td>
                            @Model.DailyCheckDate.ToString("dd/MM/yyyy")
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroilerHouseName)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroilerHouseName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodName)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroodName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.DailyCheckWeek)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.DailyCheckWeek)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.DailyCheckDay)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.DailyCheckDay)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.BroodBirdInitialNum)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.BroodBirdInitialNum)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.NaturalMortality)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.NaturalMortality)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.SelectQuantity)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.SelectQuantity)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.TotalDailyMortality)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.TotalDailyMortality)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.AccumulatedMortality)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.AccumulatedMortality)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.DailyBirdBalance)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.DailyBirdBalance)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.IncomeAccumulated)
                        </th>
                        <td>
                            @Model.IncomeAccumulated.ToString("N2") kg
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.ConsumptionQuintals)
                        </th>
                        <td>
                            @Model.ConsumptionQuintals.ToString("N2")
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.ConsumptionKilos)
                        </th>
                        <td>
                            @Model.ConsumptionKilos.ToString("N2") kg
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.AccumulatedConsumption)
                        </th>
                        <td>
                            @Model.AccumulatedConsumption.ToString("N2") kg
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.ConcentrateBalance)
                        </th>
                        <td>
                            @Model.ConcentrateBalance.ToString("N2") kg
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.DailyCheckDescription)
                        </th>
                        <td>
                            @if (string.IsNullOrWhiteSpace(
                            Model.DailyCheckDescription))
                            {
                                <span class="text-muted">
                                    Sin descripción
                                </span>
                            }
                            else
                            {
                                @Html.DisplayFor(
                                         model => model.DailyCheckDescription)
                            }
                        </td>
                    </tr>

                </tbody>

            </table>

            <div class="mt-4">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Volver
                </a>

            </div>

        </div>

    </div>

</div>