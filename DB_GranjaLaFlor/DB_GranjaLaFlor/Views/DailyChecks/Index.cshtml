@model ProjectGranjaLaFlor.Models.ViewModels.DailyCheckFilterViewModel

@{
    ViewData["Title"] = "Listado de Controles Diarios";
}

<div class="container-fluid mt-4 px-3">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">
                Controles Diarios Activos Registrados
            </h1>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
                <a asp-action="Create"
                   class="btn btn-primary">
                    Registrar Control Diario
                </a>

                <a asp-action="Inactive"
                   class="btn btn-secondary">
                    Ver Controles Inactivos
                </a>
            </div>

            <form asp-action="Index"
                  method="get"
                  class="row g-3 mb-4">

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label asp-for="BroilerHouseId"
                           class="form-label">
                    </label>

                    <select asp-for="BroilerHouseId"
                            asp-items="Model.BroilerHouseOptions"
                            class="form-select"
                            id="BroilerHouseId">
                        <option value="">Todas</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label asp-for="BroodId"
                           class="form-label">
                    </label>

                    <select asp-for="BroodId"
                            asp-items="Model.BroodOptions"
                            class="form-select"
                            id="BroodId">
                        <option value="">Seleccione una camada</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label asp-for="Year"
                           class="form-label">
                    </label>

                    <select asp-for="Year"
                            asp-items="Model.YearOptions"
                            class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label asp-for="DailyCheckWeek"
                           class="form-label">
                    </label>

                    <select asp-for="DailyCheckWeek"
                            asp-items="Model.DailyCheckWeekOptions"
                            class="form-select">
                        <option value="">Todas</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label asp-for="DailyCheckDay"
                           class="form-label">
                    </label>

                    <select asp-for="DailyCheckDay"
                            asp-items="Model.DailyCheckDayOptions"
                            class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6 d-flex align-items-end">
                    <div class="d-grid gap-2 w-100">
                        <button type="submit"
                                class="btn btn-primary">
                            Buscar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-nowrap">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .DailyCheckDate)
                            </th>

                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .DailyCheckWeek)
                            </th>

                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .DailyCheckDay)
                            </th>

                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .BroilerHouseName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .BroodName)
                            </th>

                            <th>
                                <span class="d-block">
                                    Concentrado
                                </span>

                                <span class="d-block">
                                    Acumulado
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Aves
                                </span>

                                <span class="d-block">
                                    Iniciales
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Mortalidad
                                </span>

                                <span class="d-block">
                                    Natural
                                </span>
                            </th>

                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.DailyChecks.First()
                                         .SelectQuantity)
                            </th>

                            <th>
                                <span class="d-block">
                                    Consumo
                                </span>

                                <span class="d-block">
                                    Quintales
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Consumo
                                </span>

                                <span class="d-block">
                                    Kilos
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Mortalidad
                                </span>

                                <span class="d-block">
                                    Diaria
                                </span>

                                <span class="d-block">
                                    Total
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Mortalidad
                                </span>

                                <span class="d-block">
                                    Acumulada
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Saldo
                                </span>

                                <span class="d-block">
                                    Aves
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Consumo
                                </span>

                                <span class="d-block">
                                    Acumulado
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Saldo
                                </span>

                                <span class="d-block">
                                    Concentrado
                                </span>
                            </th>

                            <th>
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.DailyChecks.Any())
                        {
                            @foreach (var dailyCheck in Model.DailyChecks)
                            {
                                <tr class="table-active">
                                    <td class="text-center">
                                        @dailyCheck.DailyCheckDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.DailyCheckWeek)
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.DailyCheckDay)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.BroilerHouseName)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.BroodName)
                                    </td>

                                    <td class="text-end">
                                        @dailyCheck.IncomeAccumulated.ToString("N2") kg
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.BroodBirdInitialNum)
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.NaturalMortality)
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.SelectQuantity)
                                    </td>

                                    <td class="text-end">
                                        @dailyCheck.ConsumptionQuintals.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @dailyCheck.ConsumptionKilos.ToString("N2") kg
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.TotalDailyMortality)
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.AccumulatedMortality)
                                    </td>

                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 dailyCheck.DailyBirdBalance)
                                    </td>

                                    <td class="text-end">
                                        @dailyCheck.AccumulatedConsumption.ToString("N2") kg
                                    </td>

                                    <td class="text-end">
                                        @dailyCheck.ConcentrateBalance.ToString("N2") kg
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@dailyCheck.DailyCheckId"
                                               class="btn btn-info btn-sm">
                                                Detalle
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@dailyCheck.DailyCheckId"
                                               class="btn btn-warning btn-sm">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@dailyCheck.DailyCheckId"
                                               class="btn btn-danger btn-sm">
                                                Desactivar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="17"
                                    class="text-center text-muted">
                                    No existen controles diarios activos que coincidan
                                    con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 text-muted">
                Se muestran como máximo 10 registros.
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const broilerHouseSelect =
                document.getElementById("BroilerHouseId");

            const broodSelect =
                document.getElementById("BroodId");

            /*
             * UI Support | Broods by Broiler House
             * Clears the previous Brood selection and loads only
             * the Broods associated with the selected Broiler House.
             *
             * This prevents a Brood from a previous Broiler House
             * from being submitted with the current filters.
             */
            async function loadBroodsByBroilerHouse() {
                const broilerHouseId =
                    broilerHouseSelect.value;

                /*
                 * Removes the Brood previously associated with
                 * another Broiler House before the filter is submitted.
                 */
                broodSelect.innerHTML =
                    '<option value="">Seleccione una camada</option>';

                broodSelect.disabled = true;

                if (!broilerHouseId) {
                    broodSelect.disabled = false;

                    return;
                }

                try {
                    const url =
                        '@Url.Action(
            "GetBroodsByBroilerHouse",
                "DailyChecks")' +
                    '?broilerHouseId=' +
                        encodeURIComponent(broilerHouseId);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error(
                            "No se pudieron cargar las camadas.");
                    }

                    const broodOptions =
                        await response.json();

                    broodOptions.forEach(function (option) {
                        const broodOption =
                            document.createElement("option");

                        broodOption.value = option.value;
                        broodOption.textContent = option.text;

                        broodSelect.appendChild(broodOption);
                    });
                }
                catch (error) {
                    console.error(
                        "Error loading Broods:",
                        error);
                }
                finally {
                    broodSelect.disabled = false;
                }
            }

            /*
             * Updates the Brood options only when the user changes
             * the selected Broiler House.
             *
             * The function is not executed automatically when the page
             * loads because the Service already restores the current
             * filter options and selected Brood.
             */
            broilerHouseSelect.addEventListener(
                "change",
                loadBroodsByBroilerHouse);
        });
    </script>
}