@model IEnumerable<ProjectGranjaLaFlor.Models.ViewModels.ExpectedValue.ExpectedValueListViewModel>

@{
    ViewData["Title"] = "Valores Esperados";
}

<div class="container mt-4">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">
                Valores Esperados Registrados
            </h1>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary text-center">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(
                                         model =>
                                         model.ExpectedValueWeek)
                            </th>

                            <th>
                                <span class="d-block">
                                    Consumo esperado
                                </span>

                                <span class="d-block">
                                    (kg)
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Peso esperado
                                </span>

                                <span class="d-block">
                                    (kg)
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Conversión
                                </span>

                                <span class="d-block">
                                    esperada
                                </span>
                            </th>

                            <th>
                                <span class="d-block">
                                    Mortalidad esperada
                                </span>

                                <span class="d-block">
                                    (%)
                                </span>
                            </th>

                            <th>
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var expectedValue in Model)
                            {
                                <tr class="table-active">
                                    <td class="text-center">
                                        @Html.DisplayFor(
                                                 modelItem =>
                                                 expectedValue.ExpectedValueWeek)
                                    </td>

                                    <td class="text-end">
                                        @expectedValue.ExpectedConsumption.ToString("N3") kg
                                    </td>

                                    <td class="text-end">
                                        @expectedValue.ExpectedWeight.ToString("N3") kg
                                    </td>

                                    <td class="text-end">
                                        @expectedValue.ExpectedConversion.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @expectedValue.ExpectedMortality.ToString("N2") %
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="Edit"
                                           asp-route-id="@expectedValue.ExpectedValueId"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted">
                                    No existen valores esperados registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 text-muted">
                Este catálogo contiene los valores esperados
                correspondientes a las seis semanas de producción.
            </div>
        </div>
    </div>
</div>