@{
    ViewData["Title"] = "Dashboard";
}

@*
    Temporary Dashboard displayed after a successful Login.
    It shows the authenticated user's information and provides
    quick access to the available application modules based on
    the user's Role.

    Additional dashboard metrics will be added as new modules
    are implemented.
*@

<div class="container mt-4">

    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Dashboard</h2>
        </div>

        <div class="card-body">

            <div class="text-center mb-4">
                <img src="~/imagenes/LogoGranjaLaFlor.png"
                     alt="Logo Granja La Flor"
                     class="img-fluid"
                     style="max-width: 180px;" />
            </div>

            <h4>
                Bienvenido, @User.Identity?.Name
            </h4>

            <p class="text-muted mb-4">
                Sistema de Gestión Operativa - Granja La Flor
            </p>

            <div class="row">

                <div class="col-md-6">
                    <strong>Usuario:</strong>
                    @User.Identity?.Name
                </div>

                <div class="col-md-6">

                    <strong>Rol:</strong>

                    @*
                    * The user's Role is read dynamically from the Role claim.
                    * This avoids hardcoding specific Role names in the Dashboard and allows
                    * the system to display future Roles created from the database.
                    *@
                    @using System.Security.Claims

                    @{
                        var roleName = User.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol asignado";
                    }

                    <span>@roleName</span>

                </div>

            </div>

        </div>
    </div>

    <div class="row">

        @if (User.IsInRole("Propietarios"))
        {
            <div class="col-md-4 mb-4">

                <div class="card border-success h-100">

                    <div class="card-header bg-success text-white">
                        Acceso y Usuarios
                    </div>

                    <div class="card-body">

                        <p>
                            Administración de Roles y Usuarios.
                        </p>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="btn btn-outline-success">
                            Ir al módulo
                        </a>

                    </div>

                </div>

            </div>
        }

        <div class="col-md-4 mb-4">

            <div class="card border-info h-100">

                <div class="card-header bg-info text-white">
                    Gestión Operativa
                </div>

                <div class="card-body">

                    <p>
                        Gestión de Mortalidad, Pesaje,
                        Consumo de Alimento, Control Diario
                        y Control Semanal.
                    </p>

                    <button class="btn btn-outline-info" disabled>
                        Próximamente
                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card border-warning h-100">

                <div class="card-header bg-warning">
                    Monitoreo
                </div>

                <div class="card-body">

                    <p>
                        Monitoreo de Temperatura y
                        Estimulación Temprana.
                    </p>

                    <button class="btn btn-outline-warning" disabled>
                        Próximamente
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>