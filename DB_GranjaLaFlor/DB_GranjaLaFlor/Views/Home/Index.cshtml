@model List<DB_GranjaLaFlor.Models.Entities.Role>

<h1>Roles</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.RoleId</td>
                <td>@role.RoleName</td>
                <td>@role.RoleDescription</td>
                <td>@role.RoleState</td>
            </tr>
        }
    </tbody>
</table>
