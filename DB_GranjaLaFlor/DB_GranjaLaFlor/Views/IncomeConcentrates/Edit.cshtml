@model DB_GranjaLaFlor.Models.ViewModels.IncomeConcentrates.IncomeConcentrateFormViewModel

@{
    ViewData["Title"] = "Editar Ingreso de Concentrado";
}

<div class="container mt-4 col-md-7">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">Editar Ingreso de Concentrado</h1>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IncomeConcentrateId" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="IncomeConcentrateDate" class="form-label"></label>
                    <input asp-for="IncomeConcentrateDate"
                           class="form-control"
                           type="date" />
                    <span asp-validation-for="IncomeConcentrateDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BroodId" class="form-label"></label>
                    <select asp-for="BroodId"
                            asp-items="Model.Broods"
                            class="form-select">
                        <option value="">Seleccione una camada</option>
                    </select>
                    <span asp-validation-for="BroodId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IncomeQuintals" class="form-label"></label>
                    <input asp-for="IncomeQuintals" class="form-control" />
                    <span asp-validation-for="IncomeQuintals" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IncomeKilos" class="form-label"></label>
                    <input asp-for="IncomeKilos"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="IncomeAccumulated" class="form-label"></label>
                    <input asp-for="IncomeAccumulated"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="IncomeDescription" class="form-label"></label>
                    <textarea asp-for="IncomeDescription" class="form-control"></textarea>
                    <span asp-validation-for="IncomeDescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-outline-info">
                        Guardar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        /*
         * UI Support | Live Concentrate Calculation
         * Updates the calculated fields on the Edit form without requiring
         * a page refresh. The official values are recalculated again in
         * the Service layer before saving the record.
         */
        async function calculateIncome() {
            const quintals = parseFloat(document.getElementById("IncomeQuintals").value) || 0;
            const broodId = document.getElementById("BroodId").value;
            const incomeConcentrateId = document.getElementById("IncomeConcentrateId").value;

            const kilos = quintals * 46;

            document.getElementById("IncomeKilos").value = kilos.toFixed(2);

            if (broodId) {
                @*
                 * Business Rule | Current Accumulated Retrieval: Requests the current accumulated concentrate for the selected 
                 * brood while excluding the income record being edited. This prevents the current record from being counted twice
                 * during the accumulated calculation.
                *@
                const response = await fetch(
                    `/IncomeConcentrates/GetCurrentAccumulatedByBrood?broodId=${broodId}&excludeIncomeConcentrateId=${incomeConcentrateId}`);

                const previousAccumulated = await response.json();

                document.getElementById("IncomeAccumulated").value =
                    (previousAccumulated + kilos).toFixed(2);
            }
            else {
                document.getElementById("IncomeAccumulated").value =
                    kilos.toFixed(2);
            }
        }

        document.getElementById("IncomeQuintals")
            .addEventListener("input", calculateIncome);

        document.getElementById("BroodId")
            .addEventListener("change", calculateIncome);
    </script>
}