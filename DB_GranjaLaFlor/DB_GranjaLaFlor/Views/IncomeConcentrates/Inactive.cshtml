@model IEnumerable<DB_GranjaLaFlor.Models.ViewModels.IncomeConcentrates.IncomeConcentrateListViewModel>

@{
    ViewData["Title"] = "Ingresos de Concentrado Inactivos";
}

<div class="container mt-4">

    <div class="card border-secondary">

        <div class="card-header bg-secondary text-white text-center">
            <h3 class="mb-0">
                Ingresos de Concentrado Inactivos
            </h3>
        </div>

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    Ingresos Desactivados
                </h5>

                <a asp-action="Index"
                   class="btn btn-outline-primary">
                    Ver Activos
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-secondary">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.IncomeConcentrateDate)
                            </th>

                            <th style="min-width:220px;">
                                @Html.DisplayNameFor(model => model.BroodName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeQuintals)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeKilos)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeAccumulated)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeDescription)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeState)
                            </th>

                            <th class="text-center" style="width: 170px;">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var income in Model)
                            {
                                <tr>
                                    <td>
                                        @income.IncomeConcentrateDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td style="min-width:220px;">
                                        @income.BroodName - Año @income.BroodYear)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => income.IncomeQuintals)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => income.IncomeKilos)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => income.IncomeAccumulated)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => income.IncomeDescription)
                                    </td>

                                    <td>
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-info btn-sm">
                                                Detalle
                                            </a>

                                            <a asp-action="Activate"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-success btn-sm">
                                                Reactivar
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted">
                                    No existen ingresos de concentrado inactivos.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>