@model IEnumerable<DB_GranjaLaFlor.Models.ViewModels.IncomeConcentrates.IncomeConcentrateListViewModel>

@{
    ViewData["Title"] = "Ingresos de Concentrado";
}

<div class="container mt-4">

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">
                Ingresos de Concentrado
            </h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    Ingresos Activos Registrados
                </h5>

                <div class="d-flex gap-2">

                    <a asp-action="Create"
                       class="btn btn-outline-primary">
                        Nuevo Ingreso
                    </a>

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.IncomeConcentrateDate)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.BroodName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeQuintals)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeKilos)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeAccumulated)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeDescription)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.IncomeState)
                            </th>

                            <th class="text-center" style="width: 170px;">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var income in Model)
                            {
                                <tr>
                                    <td>
                                        @income.IncomeConcentrateDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @income.BroodName
                                    </td>

                                    <td>
                                        @income.IncomeQuintals
                                    </td>

                                    <td>
                                        @income.IncomeKilos
                                    </td>

                                    <td>
                                        @income.IncomeAccumulated
                                    </td>

                                    <td>
                                        @income.IncomeDescription
                                    </td>

                                    <td>
                                        @if (income.IncomeState)
                                        {
                                            <span class="badge bg-info">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-info btn-sm">

                                                Detalle

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-warning btn-sm">

                                                Editar

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-danger btn-sm">

                                                Eliminar

                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted">

                                    No existen ingresos de concentrado registrados.

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section Scripts
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const alerts = document.querySelectorAll(".alert");

                alerts.forEach(function (alert) {

                    setTimeout(function () {

                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bsAlert.close();

                    }, 2500);

                });

            });
        </script>
    }
</div>