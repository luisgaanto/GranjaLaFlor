@model ProjectGranjaLaFlor.ViewModels.IncomeConcentrates.IncomeConcentrateFilterViewModel

@{
    ViewData["Title"] = "Ingresos de Concentrado";
}

<div class="container mt-4">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">
                Ingresos de Concentrado
            </h3>
        </div>

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Ingresos Activos Registrados
                </h5>

                <div class="d-flex gap-2">

                    <a asp-action="Create"
                       class="btn btn-outline-primary">
                        Nuevo Ingreso
                    </a>

                    <a asp-action="Inactive"
                       class="btn btn-outline-secondary">
                        Ver Inactivos
                    </a>

                </div>

            </div>

            <!--
                Sends the selected filters to the Index GET action
                through query string parameters.
            -->
            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end mb-4">

                <div class="col-md-4">

                    <label asp-for="BroodName"
                           class="form-label">
                        Camada
                    </label>

                    <select asp-for="BroodName"
                            asp-items="Model.BroodOptions"
                            class="form-select">

                        <option value="">
                            Todas las camadas
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label asp-for="Year"
                           class="form-label">
                        Año
                    </label>

                    <select asp-for="Year"
                            asp-items="Model.YearOptions"
                            class="form-select">

                        <option value="">
                            Todos los años
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label asp-for="BroilerHouseId"
                           class="form-label">
                        Pollera
                    </label>

                    <select asp-for="BroilerHouseId"
                            asp-items="Model.BroilerHouseOptions"
                            class="form-select">

                        <option value="">
                            Todas las polleras
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <div class="d-grid gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Filtrar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-primary">

                        <tr>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeConcentrateDate)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .BroodName)
                            </th>

                            <th style="min-width: 180px;">
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .BroilerHouseName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeQuintals)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeKilos)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeAccumulated)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeDescription)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model =>
                                         model.IncomeConcentrates
                                         .First()
                                         .IncomeState)
                            </th>

                            <th class="text-center"
                                style="width: 170px;">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.IncomeConcentrates.Any())
                        {
                            foreach (var income in Model.IncomeConcentrates)
                            {
                                <tr>

                                    <td>
                                        @income.IncomeConcentrateDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <!--
                                        Displays the Brood name and registration
                                        year to identify the selected Brood.
                                    -->
                                    <td style="min-width: 180px;">
                                        @income.BroodName - Año @income.BroodYear
                                    </td>

                                    <td style="min-width: 180px;">
                                        @Html.DisplayFor(modelItem =>
                                                 income.BroilerHouseName)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem =>
                                                 income.IncomeQuintals)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem =>
                                                 income.IncomeKilos)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem =>
                                                 income.IncomeAccumulated)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem =>
                                                 income.IncomeDescription)
                                    </td>

                                    <td>

                                        @if (income.IncomeState)
                                        {
                                            <span class="badge bg-info">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-info btn-sm">
                                                Detalle
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-warning btn-sm">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@income.IncomeConcentrateId"
                                               class="btn btn-outline-danger btn-sm">
                                                Eliminar
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center text-muted">

                                    No existen ingresos de concentrado que coincidan
                                    con los filtros seleccionados.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const alerts = document.querySelectorAll(".alert");

            alerts.forEach(function (alert) {

                setTimeout(function () {

                    const bsAlert =
                        bootstrap.Alert.getOrCreateInstance(alert);

                    bsAlert.close();

                }, 2500);

            });

        });
    </script>
}