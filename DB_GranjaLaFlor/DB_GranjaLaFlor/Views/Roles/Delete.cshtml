@model DB_GranjaLaFlor.Models.Entities.Role

@{
    ViewData["Title"] = "Desactivar Rol";
}

<div class="container mt-4 col-md-7">

    <div class="card border-active">

        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">Eliminar Rol</h1>
        </div>

        <div class="card-body">

            <!-- When using Partial view, you can use "Partial Tag Helper" to mapped event message as below. Refer to _EventMessage view.
            <partial name="_EventMessage" />
            -->
            <table class="table table-hover table-bordered align-middle">

                <tbody>

                    <tr class="table-active">
                        <th style="width:35%">
                            @Html.DisplayNameFor(model => model.RoleName)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.RoleName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.RoleDescription)
                        </th>
                        <td>
                            @Html.DisplayFor(model => model.RoleDescription)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.RoleState)
                        </th>
                        <td>

                            @if (Model.RoleState)
                            {
                                <span class="badge bg-info">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }

                        </td>
                    </tr>

                </tbody>

            </table>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="RoleId" />

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Eliminar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>