@model DB_GranjaLaFlor.Models.Entities.Role

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="container mt-4 col-md-7">

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">Editar Rol</h1>
        </div>

        <div class="card-body">

            <!-- When using Partial view, you can use "Partial Tag Helper" to mapped event message as below. Refer to _EventMessage view.
            <partial name="_EventMessage" />
            -->

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="RoleId" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label"></label>
                    <input asp-for="RoleName" class="form-control" />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoleDescription" class="form-label"></label>
                    <textarea asp-for="RoleDescription" class="form-control"></textarea>
                    <span asp-validation-for="RoleDescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-outline-info">
                        Guardar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}