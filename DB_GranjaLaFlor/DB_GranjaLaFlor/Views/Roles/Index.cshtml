@model IEnumerable<DB_GranjaLaFlor.Models.Entities.Role>

@{
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Roles</h1>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                Nuevo Rol
            </a>

            <a asp-action="Inactive" class="btn btn-secondary">
                Ver Inactivos
            </a>
        </div>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.RoleName)</th>
                <th>@Html.DisplayNameFor(model => model.RoleDescription)</th>
                <th>@Html.DisplayNameFor(model => model.RoleState)</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var role in Model)
                {
                    <tr>
                        <td>@role.RoleName</td>
                        <td>@role.RoleDescription</td>
                        <td>
                            @if (role.RoleState)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@role.RoleId"
                               class="btn btn-info btn-sm">
                                Detalle
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@role.RoleId"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@role.RoleId"
                               class="btn btn-danger btn-sm">
                                Desactivar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No existen roles registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>