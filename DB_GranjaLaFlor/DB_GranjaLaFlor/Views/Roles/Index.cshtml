@model IEnumerable<DB_GranjaLaFlor.Models.Entities.Role>

@{
    ViewData["Title"] = "Listado de Roles";
}

<div class="container mt-4">

    <!-- When using Partial view, you can use "Partial Tag Helper" to mapped event message as below. Refer to _EventMessage view.-->
    <partial name="_EventMessage" />

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">
                Listado de Roles
            </h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    Roles Activos Registrados
                </h5>

                <div class="d-flex gap-2">

                    <a asp-action="Create"
                       class="btn btn-outline-primary">
                        Nuevo Rol
                    </a>

                    <a asp-action="Inactive"
                       class="btn btn-outline-secondary">
                        Ver Inactivos
                    </a>

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.RoleName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.RoleDescription)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.RoleState)
                            </th>

                            <th class="text-center" style="width: 170px;">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>
                                    <td>
                                        @role.RoleName
                                    </td>

                                    <td>
                                        @role.RoleDescription
                                    </td>

                                    <td>
                                        @if (role.RoleState)
                                        {
                                            <span class="badge bg-info">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@role.RoleId"
                                               class="btn btn-outline-info btn-sm">

                                                Detalle

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@role.RoleId"
                                               class="btn btn-outline-warning btn-sm">

                                                Editar

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@role.RoleId"
                                               class="btn btn-outline-danger btn-sm">

                                                Eliminar

                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted">

                                    No existen roles registrados.

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @section Scripts
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const alerts = document.querySelectorAll(".alert");

                alerts.forEach(function (alert) {

                    setTimeout(function () {

                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bsAlert.close();

                    }, 2500);

                });

            });
        </script>
    }
</div>