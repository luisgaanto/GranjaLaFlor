<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Granja La Flor</title>

    <!-- Bootswatch Theme: Sandstone -->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/sandstone/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DB_GranjaLaFlor.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary border-bottom box-shadow mb-3" data-bs-theme="dark">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Granja La Flor
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarColor01"
                        aria-controls="navbarColor01"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarColor01">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link active dropdown-toggle"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                                <span class="visually-hidden">(current)</span>
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link active dropdown-toggle"
                               href="#"
                               id="profileDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Perfil
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="profileDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Roles
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Users"
                                       asp-action="Index">
                                        Usuarios
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link active dropdown-toggle"
                               href="#"
                               id="profileDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Gestión
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="profileDropdown">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        Polleras
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Polleras
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Camadas
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Ingreso de Concentrado
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Control Semanal
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Roles"
                                       asp-action="Index">
                                        Control Diario
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        Camadas
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        Ingreso de Concentrado
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        Control Diario
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">
                                        Control Semanal
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>

                    <form class="d-flex me-3">
                        <input class="form-control me-sm-2"
                               type="search"
                               placeholder="Buscar">

                        <button class="btn btn-outline-secondary my-2 my-sm-0"
                                type="submit">
                            Buscar
                        </button>
                    </form>

                    <!-- btn btn-outline-info-->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Login
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Granja La Flor
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>