@model DB_GranjaLaFlor.Models.Entities.User

@{
    ViewData["Title"] = "Desactivar Usuario";
}

<div class="container mt-4 col-md-7">

    <div class="card border-primary">

        <div class="card-header bg-primary text-white text-center">
            <h1 class="mb-0">
                Desactivar Usuario
            </h1>
        </div>

        <div class="card-body">
            <!-- <partial name="_EventMessage" /> -->
            <table class="table table-hover table-bordered align-middle">
                <tbody>

                    <tr class="table-active">
                        <th style="width:35%">
                            @Html.DisplayNameFor(model => model.UserName)
                        </th>

                        <td>
                            @Html.DisplayFor(model => model.UserName)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.UserEmail)
                        </th>

                        <td>
                            @Html.DisplayFor(model => model.UserEmail)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.UserDescription)
                        </th>

                        <td>
                            @Html.DisplayFor(model => model.UserDescription)
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.RoleId)
                        </th>

                        <td>
                            @Model.Role?.RoleName
                        </td>
                    </tr>

                    <tr class="table-active">
                        <th>
                            @Html.DisplayNameFor(model => model.UserState)
                        </th>

                        <td>
                            <span class="badge bg-info">
                                Activo
                            </span>
                        </td>
                    </tr>

                </tbody>
            </table>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="UserId" />

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-outline-danger">

                        Desactivar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Volver

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>