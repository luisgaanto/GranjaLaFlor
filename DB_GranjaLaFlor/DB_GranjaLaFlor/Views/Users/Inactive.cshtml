@model IEnumerable<DB_GranjaLaFlor.Models.Entities.User>

@{
    ViewData["Title"] = "Usuarios Inactivos";
}

<div class="container mt-4">
    <partial name="_EventMessage" />

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">Usuarios Inactivos</h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Usuarios Inactivos Registrados</h5>

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-primary">
                        Ver Usuarios Activos
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.UserEmail)</th>
                            <th>@Html.DisplayNameFor(model => model.UserDescription)</th>
                            <th>@Html.DisplayNameFor(model => model.RoleId)</th>
                            <th>@Html.DisplayNameFor(model => model.UserState)</th>
                            <th class="text-center" style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.UserEmail</td>
                                    <td>@user.UserDescription</td>
                                    <td>@user.Role?.RoleName</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-info btn-sm">
                                                Detalle
                                            </a>
                                            <a asp-action="Activate"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-danger btn-sm">
                                                Reactivar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No existen usuarios inactivos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>