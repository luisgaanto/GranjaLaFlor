@model IEnumerable<DB_GranjaLaFlor.Models.Entities.User>

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="container mt-4">
    <!--<partial name="_EventMessage" />-->

    <div class="card border-primary">
        <div class="card-header bg-primary text-white text-center">
            <h3 class="mb-0">Listado de Usuarios</h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Usuarios Activos Registrados</h5>

                <div class="d-flex gap-2">
                    <a asp-action="Create" class="btn btn-outline-primary">
                        Nuevo Usuario
                    </a>

                    <a asp-action="Inactive" class="btn btn-outline-secondary">
                        Ver Inactivos
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.UserEmail)</th>
                            <th>@Html.DisplayNameFor(model => model.RoleId)</th>
                            <th>@Html.DisplayNameFor(model => model.UserState)</th>
                            <th>@Html.DisplayNameFor(model => model.UserDescription)</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr class="table-active">
                                    <td>@user.UserName</td>
                                    <td>@user.UserEmail</td>
                                    <td>@user.Role?.RoleName</td>
                                    <td>
                                        @if (user.UserState)
                                        {
                                            <span class="badge bg-info">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td>@user.UserDescription</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Details"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-info btn-sm">
                                                Detalle
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-warning btn-sm">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-danger btn-sm">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No existen usuarios registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>