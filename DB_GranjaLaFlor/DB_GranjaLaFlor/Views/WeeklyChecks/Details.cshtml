@model ProjectGranjaLaFlor.Models.ViewModels.WeeklyCheck.WeeklyCheckGetByIdViewModel

@{
    ViewData["Title"] = "Detalle de Control Semanal";
}

<div class="container mt-4">

    <div class="card border-primary">

        @*
        Main Header | Weekly Check Details
        *@
        <div class="card-header bg-primary text-white text-center">

            <h1 class="mb-0">
                Detalle de Control Semanal
            </h1>

        </div>

        <div class="card-body">

            @*
            Event Message
            Displays notifications generated by the Controller.
            *@
            <partial name="_EventMessage" />

            @*
            Details Layout
            Displays the Weekly Check information using two
            information cards per row on medium and large screens.
            *@
            <div class="row g-4">

                @*
                General Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Información General
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:45%">
                                            @Html.DisplayNameFor(
                                                     model => model.BroilerHouseName)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.BroilerHouseName)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.BroodName)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.BroodName)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.BroodDate)
                                        </th>

                                        <td>
                                            @Model.BroodDate.ToString("dd/MM/yyyy")
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyCheckWeek)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyCheckWeek)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Base Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Información Base
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:55%">
                                            @Html.DisplayNameFor(
                                                     model => model.BroodBirdInitialNum)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.BroodBirdInitialNum)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.FinalAccumulatedMortality)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.FinalAccumulatedMortality)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.FinalDailyBirdBalance)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.FinalDailyBirdBalance)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.FinalAccumulatedConsumption)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.FinalAccumulatedConsumption)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.FinalConcentrateBalance)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.FinalConcentrateBalance)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.SampleBirdQuantity)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.SampleBirdQuantity)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Weight Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Peso
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:55%">
                                            @Html.DisplayNameFor(
                                                     model => model.TotalBirdWeight)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.TotalBirdWeight)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyExpectedWeight)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyExpectedWeight)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.AverageWeeklyWeight)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.AverageWeeklyWeight)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyWeightDifference)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyWeightDifference)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Consumption Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Consumo
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:55%">
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyExpectedConsumption)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyExpectedConsumption)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyRealConsumption)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyRealConsumption)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyConsumptionDifference)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyConsumptionDifference)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Conversion Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Conversión
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:55%">
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyExpectedConversion)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyExpectedConversion)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyRealConversion)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyRealConversion)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyConversionDifference)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyConversionDifference)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Mortality Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Mortalidad
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:55%">
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyExpectedMortality)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyExpectedMortality)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyRealMortality)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyRealMortality)
                                        </td>

                                    </tr>

                                    <tr class="table-active">

                                        <th>
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyMortalityDifference)
                                        </th>

                                        <td>
                                            @Html.DisplayFor(
                                                     model => model.WeeklyMortalityDifference)
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Description
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Descripción
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:35%">
                                            @Html.DisplayNameFor(
                                                     model => model.WeeklyCheckDescription)
                                        </th>

                                        <td>

                                            @if (string.IsNullOrWhiteSpace(
                                            Model.WeeklyCheckDescription))
                                            {
                                                <span class="text-muted">
                                                    Sin descripción
                                                </span>
                                            }
                                            else
                                            {
                                                @Html.DisplayFor(
                                                         model => model.WeeklyCheckDescription)
                                            }

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                @*
                Record Information
                *@
                <div class="col-md-6">

                    <div class="card bg-light border-secondary h-100">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Estado
                            </h5>

                        </div>

                        <div class="card-body">

                            <table class="table table-hover table-bordered align-middle mb-0">

                                <tbody>

                                    <tr class="table-active">

                                        <th style="width:50%">
                                                @Html.DisplayNameFor(
                                                         model => model.WeeklyCheckState)
                                        </th>

                                        <td>

                                                @if (Model.WeeklyCheckState)
                                                {
                                                <span class="badge bg-success">
                                                    Activo
                                                </span>
                                                }
                                                else
                                                {
                                                <span class="badge bg-danger">
                                                    Inactivo
                                                </span>
                                                }

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                @*
                Daily Checks
                Displays the seven Daily Check records used
                to generate the selected Weekly Check.
                *@
                <div class="col-12">

                    <div class="card bg-light border-secondary">

                        <div class="card-header weekly-details-header">

                            <h5 class="mb-0">
                                Controles diarios
                            </h5>

                        </div>

                        <div class="card-body">

                            <div class="table-responsive">

                                <table class="table table-hover table-bordered align-middle mb-0">

                                    <thead class="table-primary text-center">

                                        <tr>

                                            <th>
                                                Fecha
                                            </th>

                                            <th>
                                                Día
                                            </th>

                                            <th>
                                                Semana
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Mortalidad
                                                </span>
                                                <span class="d-block">
                                                    Diaria
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Mortalidad
                                                </span>
                                                <span class="d-block">
                                                    Acumulada
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Saldo
                                                </span>
                                                <span class="d-block">
                                                    Aves
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Ingreso Concentrado
                                                </span>
                                                <span class="d-block">
                                                    Acumulado (kg)
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Consumo
                                                </span>
                                                <span class="d-block">
                                                    Diario (kg)
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Consumo
                                                </span>
                                                <span class="d-block">
                                                    Acumulado (kg)
                                                </span>
                                            </th>

                                            <th>
                                                <span class="d-block">
                                                    Saldo
                                                </span>
                                                <span class="d-block">
                                                    Concentrado (kg)
                                                </span>
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @if (Model.DailyChecks.Any())
                                        {
                                            @foreach (var dailyCheck in Model.DailyChecks)
                                            {
                                                <tr class="table-active">

                                                    <td class="text-center">
                                                        @dailyCheck.DailyCheckDate.ToString("dd/MM/yyyy")
                                                    </td>

                                                    <td class="text-center">
                                                        @dailyCheck.DailyCheckDay
                                                    </td>

                                                    <td class="text-center">
                                                        @dailyCheck.DailyCheckWeek
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.TotalDailyMortality
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.AccumulatedMortality
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.DailyBirdBalance
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.IncomeAccumulated.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.ConsumptionKilos.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.AccumulatedConsumption.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @dailyCheck.ConcentrateBalance.ToString("N2")
                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>

                                                <td colspan="10"
                                                    class="text-center text-muted">

                                                    No existen controles diarios
                                                    asociados a este control semanal.

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            @*
            Navigation Actions
            *@
            <div class="d-flex justify-content-center gap-2 mt-4">

                @if (Model.WeeklyCheckState)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.WeeklyCheckId"
                       class="btn btn-warning">

                        Editar

                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Volver

                </a>

            </div>

        </div>

    </div>

</div>